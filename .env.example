# Shared platform data root; the gateway writes only under $TRADEQ_DATA_DIR/risk-gated-mcp-gateway/
# (plus the S6 offline inbox, $TRADEQ_DATA_DIR/research-ledger/inbox/, as contract 6.1 allows).
TRADEQ_DATA_DIR=/absolute/path/to/Tradeq/data

# Admin API key (Authorization: Bearer <key>). The admin API returns 503 while this is unset.
GATEWAY_ADMIN_API_KEY=change-me

# Session API key used by `gateway stdio` (printed once by `gateway session-create` or POST /admin/v1/sessions).
GATEWAY_AGENT_API_KEY=

# Optional: alternative settings file; any key can be overridden as GATEWAY_<SECTION>__<KEY>.
# GATEWAY_SETTINGS_FILE=config/settings.yaml
# GATEWAY_MODES__LIVE_ENABLED=false
# GATEWAY_SERVICES__SHADOW__BASE_URL=http://127.0.0.1:8610

# T-Bank Invest API token, used only by the tbank-sandbox broker (paper sessions created with broker=tbank-sandbox).
# TBANK_TOKEN=
